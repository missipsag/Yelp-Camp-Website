<%- layout('layouts/boilerplate.ejs') %>
<link rel="stylesheet" href="/css/stars.css"> 
<%- include('../partials/flash') %>
<div class="row"> 
    <div class="col-6   ">
      <div class="card mb-4" >
        <div id="campgroundCaroueslIndicators" class="carousel slide">
          <div class="carousel-indicators">
            <%for (let i=0; i < campground.image.length; i++) { %>   
              <button type="button" data-bs-target="#campgroundCaroueslIndicators" data-bs-slide-to=`${i}` class="active" aria-current="true" aria-label=`Slide ${i}`></button>
            <% } %> 
          </div>
          <div class="carousel-inner">
			        <% campground.image.forEach((image, i) => {  %>                    
                <div class="carousel-item <%= i === 0 ? 'active' :  '' %>">            
                  <img src="<%=campground.image[i].url%> " class="d-block w-100" alt="...">
                </div>
              <% }) %> 
            
            </div>
            <% if(campground.image.length > 1) { %> 
              <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCaroueslIndicators" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#campgroundCaroueslIndicators" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <% } %> 
          </div>
        <div class="card-body">
          <h5 class="card-title"><%= campground.name %></h5>
          <p class="card-text"><%= campground.description %>
          </p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><span class="text-muted">Locaton : </span> <%= campground.location %></li>
          <li class="list-group-item"> <span class="text-muted">Price : </span><%= campground.price %> $</li>
          <li class="list-group-item"> <span class="text-muted">Author : </span><%= campground.author.username %></li>
        </ul>
        <div class="card-body d-flex justify-content-around">
          <!-- Check if the the currUser is the author of this campground to enable edit and delete --> 
          <!-- First we check if the current user is logged in, then we compare his ID with the author -->
          <% if(currUser && campground.author.equals(currUser._id)){ %> 
            <form  action="/campgrounds/<%= campground._id %>/?_method=DELETE" method="POST">
              <button class="btn btn-danger">Remove Camp</button>
            </form>
            <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-primary">Edit info</a>
          <% }  %> 
          <a href="/campgrounds" class="btn btn-success">Back</a>
        </div>
      </div>
    </div>
    
    <div id="map" style="width: 400px; height: 300px;">

    </div>

    <div class="col-6"> 
          <% if( currUser) { %> 
            <h2>Leave a Review</h2>
            <form action="/campgrounds/<%=campground._id%>/reviews" method="POST" class="mb-3 validated-form" novalidate>
              <div class="mb-3">
                
                <fieldset class="starability-coinFlip">
                  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="rating" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="rating" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="rating" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="rating" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="rating" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label class="form-label" for="body">Review</label>
                <textarea class="form-control" name="body" id="body" cols="30" rows="3" required></textarea>
                <div class="valid-feedback">
                  Looks good!
                </div>
              </div>
              <button class="btn btn-success">Submit</button>
            </form>
          <% } %> 
        <% if (campground.reviews.length){  %> 
        <h2 class="text-center mb-3">Site reviews : </h2>
        <div class="mb-3">
          <% for( let rev of campground.reviews) {  %>
            <div class="card mb-3">
              <div class="card-body">
                <h4><%= rev.author.username %> </h4>
                 <p class="starability-result" data-rating="<%= rev.rating %>">
                    Rated:  <%= rev.rating %> stars
                  </p>
                <p class="card-text"><%= rev.body %> </p>
                <!-- check if the currUser is the author of current review, if yes display delete button -->
                <% if(currUser && rev.author.equals(currUser._id)){ %>  
                  <form  action="/campgrounds/<%=campground._id%>/reviews/<%=rev._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-sm btn-danger"> Delete</button>
                  </form>
                <% } %> 
              </div>
            </div>
          <% } %> 
        </div>
        <% } %> 
    </div>
</div>
<!-- this is for our map, we have to instanciate the maptilerApiKey so that
  ejs engine cas acces it. (BECAUSE EJS DOSN'T ACCESS THE JS SCRIPTS) -->
<script>
  const maptilerApiKey = '<%-process.env.MAPTILER_API_KEY%>';
  const campground = <%- JSON.stringify(campground) %>
</script>
<script src="/javascripts/showPageMap.js"></script>